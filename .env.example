# CNJ70 Ecommerce - Environment Configuration
# Copy this file to .env and fill in the actual values

# MongoDB (loaded by DotenvInitializer)
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
# MONGODB_DATABASE=cnj70_ecommerce

# JWT Secret (minimum 256-bit key for HS256)
# Generate with: openssl rand -base64 32
JWT_SECRET=mySecretKeyForJWTTokenGenerationMustBeAtLeast256BitsLong

# Encryption Key for PII Data (AES-256-GCM)
# Generate with: openssl rand -base64 32
# MUST be set for the application to start
# ENCRYPTION_KEY=<YOUR_32BYTE_BASE64_KEY>

# KYC 3rd-party Provider (optional for dev)
# KYC_PROVIDER_URL=https://kyc-provider.example.com/api/verify
# KYC_PROVIDER_API_KEY=
